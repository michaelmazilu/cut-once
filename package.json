{
  "name": "cut-once",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm -F @cutonce/api dev",
    "serve:local": "bash infra/ensure-token.sh && pnpm -F @cutonce/web build && HOST=0.0.0.0 NODE_ENV=production pnpm -F @cutonce/api start",
    "tunnel": "bash infra/tunnel.sh",
    "pm": "pnpm -F @cutonce/project-model exec tsx src/cli.ts",
    "reindex": "pnpm -F @cutonce/api exec tsx src/cli/reindex.ts",
    "elastic:indices": "pnpm -F @cutonce/api exec tsx src/cli/elastic-indices.ts",
    "elastic:setup": "pnpm -F @cutonce/api exec tsx src/cli/elastic-setup.ts",
    "search:eval": "pnpm -F @cutonce/api exec tsx src/cli/search-eval.ts",
    "build:fixtures": "pnpm -F @cutonce/api exec tsx src/cli/build-fixtures.ts",
    "build:record": "pnpm -F @cutonce/api exec tsx src/cli/build-record.ts",
    "build:eval": "pnpm -F @cutonce/api exec tsx src/cli/build-eval.ts",
    "extract:eval": "pnpm -F @cutonce/api exec tsx src/cli/extract-eval.ts",
    "copilot:fixtures": "pnpm -F @cutonce/api exec tsx src/cli/copilot-fixtures.ts",
    "g0": "pnpm -F @cutonce/api exec tsx src/cli/g0-check.ts",
    "copilot:smoke": "pnpm -F @cutonce/api exec tsx src/cli/copilot-smoke.ts",
    "build:smoke": "pnpm -F @cutonce/api exec tsx src/cli/build-smoke.ts",
    "omni:probe": "pnpm -F @cutonce/api exec tsx src/cli/omni-probe.ts",
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "gen:fixtures": "pnpm -F @cutonce/project-model exec tsx scripts/gen-fixtures.ts",
    "backup": "sh -c 'mkdir -p backups && rsync -a ./data/runtime/ \"./backups/$(date +%Y%m%d-%H%M%S)/\"'",
    "llm:smoke": "pnpm -F @cutonce/api exec tsx src/cli/llm-smoke.ts",
    "tts:smoke": "pnpm -F @cutonce/api exec tsx src/cli/tts-smoke.ts",
    "sim": "tsx tools/sim/run.ts",
    "quest:core-test": "bash tools/quest-tests/run.sh",
    "quest:bundle": "bash tools/quest-tests/bundle.sh",
    "quest:setup": "tsx tools/quest/unity.ts setup",
    "quest:check": "tsx tools/quest/unity.ts check",
    "quest:sim": "tsx tools/quest/unity.ts sim",
    "quest:play": "tsx tools/quest/unity.ts play",
    "quest:build": "tsx tools/quest/unity.ts build",
    "quest:surface-proof": "tsx tools/quest/unity.ts surface-proof",
    "quest:recognition-proof": "tsx tools/quest/unity.ts recognition-proof",
    "quest:convert-model": "tsx tools/quest/unity.ts convert-model",
    "quest:device-status": "node tools/quest/device-status.mjs",
    "quest:install": "tsx tools/quest/unity.ts install"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
